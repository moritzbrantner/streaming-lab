{
  "name": "streaming-lab-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:assets": "bun run scripts/check-object-assets.ts && bun run scripts/check-refinement-assets.ts",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check": "bun run test && bun run typecheck && bun run check:assets && bun run check:boundaries && bun run build"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "24.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.2"
  }
}
